# --- JavaScript / Node ---
node_modules
node_modules.nosync
# iCloud makes "node_modules 2", "node_modules 3"… when it thinks two machines
# touched the folder at once. Never commit those.
node_modules [0-9]*
npm-debug.log*
yarn-error.log*
.npm

# --- Vite build output ---
dist
dist-ssr
*.local
.vite

# --- TypeScript ---
tsconfig.tsbuildinfo
*.tsbuildinfo

# --- Rust / Tauri ---
src-tauri/target
src-tauri/target.nosync
src-tauri/gen
src-tauri/WixTools
**/*.rs.bk
*.pdb

# --- Release staging ---
# The release job in .github/workflows/build.yml builds these in the workspace
# on its way to publishing. CI always starts from a clean checkout so it never
# commits them — this is here for when you run those steps by hand locally.
artifacts/
release-files/
release-notes.md

# --- Editors ---
.vscode/*
!.vscode/extensions.json
.idea

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Environment ---
.env
.env.local
.env.*.local
